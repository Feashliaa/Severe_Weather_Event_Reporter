# LLM Provider
LLM_PROVIDER=gemini

# API Keys (only need the one matching LLM_PROVIDER)
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=

GOOGLE_API_KEY_FREE=
GOOGLE_API_KEY_PAID=

# Optional: override default model
# ANTHROPIC_MODEL=claude-sonnet-4-6
# OPENAI_MODEL=gpt-5.4-nano-2026-03-17
# GEMINI_MODEL=gemini-3.1-flash-lite-preview

# Output directory for generated reports
OUTPUT_DIR=./output

# Cache directory for downloaded radar files
CACHE_DIR=./.cache